{
  "name": "@yuanai/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "description": "元AI Electron desktop client",
  "homepage": "https://github.com/liaojie1314/yuanai",
  "author": {
    "name": "yuanyuan",
    "email": "1517438366@qq.com"
  },
  "build": {
    "appId": "com.yuanai.desktop",
    "productName": "YuanAI",
    "artifactName": "YuanAI-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "../mobile/assets/icon.png",
        "to": "tray-icon.png"
      }
    ],
    "linux": {
      "category": "Utility",
      "maintainer": "YuanAI <1517438366@qq.com>",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "YuanAI-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "YuanAI-${version}-portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "liaojie1314",
      "repo": "yuanai",
      "releaseType": "release"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "node ../../scripts/desktop-preview.mjs",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:mac": "pnpm run build && electron-builder --mac --publish never",
    "package:linux": "pnpm run build && electron-builder --linux --publish never",
    "package:all": "pnpm run build && electron-builder -mwl --publish never",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --exclude \"tests/e2e/**\"",
    "test:unit": "vitest run --exclude \"tests/integration/**\" --exclude \"tests/e2e/**\"",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build:unpack && playwright test"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@tanstack/react-query": "5.101.2",
    "@uiw/react-codemirror": "4.25.11",
    "@yuanai/core": "workspace:*",
    "@yuanai/types": "workspace:*",
    "@yuanai/ui": "workspace:*",
    "electron-updater": "^6.3.0",
    "eventsource-parser": "3.0.6",
    "i18next": "24.2.3",
    "katex": "0.17.0",
    "lucide-react": "0.460.0",
    "react-i18next": "15.7.4",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.0.2",
    "react-syntax-highlighter": "16.1.1",
    "react-virtuoso": "4.18.10",
    "rehype-katex": "7.0.1",
    "remark-gemoji": "8.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "25.0.1",
    "msw": "2.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "2.1.9"
  }
}
