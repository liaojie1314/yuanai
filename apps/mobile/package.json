{
  "name": "@yuanai/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "build:android:preview": "pnpm dlx eas-cli@12.0.0 build --platform android --profile preview --non-interactive",
    "build:android:production": "pnpm dlx eas-cli@12.0.0 build --platform android --profile production --non-interactive --wait --json",
    "package:android:local": "pnpm run prebuild && node ../../scripts/package-mobile-android.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild && bash scripts/patch-android-mirrors.sh",
    "prebuild:clean": "expo prebuild --clean && bash scripts/patch-android-mirrors.sh",
    "android:mirror": "bash scripts/patch-android-mirrors.sh",
    "lint": "eslint 'app/**/*.{ts,tsx}' 'src/**/*.{ts,tsx}' --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.0.6",
    "@hookform/resolvers": "^3.9.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-navigation/drawer": "^7.1.1",
    "@sentry/react-native": "~6.3.0",
    "@shopify/flash-list": "1.7.2",
    "@tanstack/react-query": "^5.62.0",
    "@yuanai/core": "workspace:*",
    "@yuanai/types": "workspace:*",
    "expo": "~52.0.20",
    "expo-application": "~6.0.1",
    "expo-av": "~15.0.2",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.3",
    "expo-document-picker": "~13.0.1",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.0",
    "expo-image": "~2.0.3",
    "expo-image-picker": "~16.0.3",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.3",
    "expo-localization": "~16.0.0",
    "expo-notifications": "~0.29.11",
    "expo-router": "~4.0.11",
    "expo-screen-orientation": "~8.0.3",
    "expo-secure-store": "~14.0.0",
    "expo-speech-recognition": "^1.1.1",
    "expo-splash-screen": "~0.29.16",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.26.10",
    "expo-web-browser": "~14.0.1",
    "i18next": "^24.0.5",
    "js-sha256": "^1.0.0",
    "lucide-react-native": "^0.469.0",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-hook-form": "^7.53.2",
    "react-i18next": "^15.1.3",
    "react-native": "0.76.5",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-keyboard-controller": "^1.15.1",
    "react-native-markdown-display": "^7.0.0-alpha.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.8.0",
    "react-native-syntax-highlighter": "^2.1.0",
    "react-native-webview": "13.12.5",
    "react-syntax-highlighter": "16.1.1",
    "zod": "3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.0.0",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "18.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "babel-preset-expo": "~12.0.4",
    "eslint": "^9.16.0",
    "eslint-config-expo": "~8.0.1",
    "jsdom": "^25.0.1",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
