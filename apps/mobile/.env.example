# API 地址。Expo 会自动把 EXPO_PUBLIC_ 前缀注入到 process.env（含 dev/prod）。
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Mock 模式开关。设为 1 时 app 启动会激活 MSW 拦截（当前 mobile 端 msw/native 未接入）。
# 由 pnpm dev:mobile:mock 自动写入；pnpm dev:mobile 会清除此变量。
EXPO_PUBLIC_MOCK=

# Sentry DSN（可选）。留空时跳过 Sentry 初始化。
EXPO_PUBLIC_SENTRY_DSN=

# Google Sign-In（可选）。Google Cloud Console 生成的 OAuth 客户端 ID。
# webClientId 同时作为 Android serverClientId；iOS 客户端 ID 反向 URL Scheme
# 需另在 app.json 中的 iosUrlScheme 里写。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Web 站点 origin（分享链接用，与后端 WEB_APP_URL 一致）
EXPO_PUBLIC_WEB_APP_URL=http://localhost:3000
