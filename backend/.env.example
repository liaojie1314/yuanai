# ── 数据库 ────────────────────────────────────────────────────────────
# Docker Compose 默认配置（宿主机端口 5433 避免与本机 PostgreSQL 冲突）
DATABASE_URL=postgresql+asyncpg://yuanai:password@localhost:5433/yuanai

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────
# 生产环境务必替换为随机字符串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI 大模型（至少配置一个，未配置的模型不会出现在模型列表中）────────
# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude)：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── 文件存储（S3 兼容，默认使用 Docker Compose 内的 MinIO）────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=yuanai-files
S3_PUBLIC_URL=http://localhost:9000/yuanai-files

# ── 邮箱验证码（QQ 邮箱示例）───────────────────────────────────────────
# 用于注册时向填写的邮箱发送 6 位验证码；未配置 SMTP_USER 则验证码接口会返回 500
# 授权码获取：QQ 邮箱 → 设置 → 账户 → 开启"POP3/SMTP 服务" → 生成授权码（16 位字符串）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-account@qq.com
SMTP_PASSWORD=your-16-char-authorization-code
SMTP_FROM_NAME=元AI
VERIFY_CODE_TTL_SECONDS=600
VERIFY_CODE_SEND_INTERVAL_SECONDS=60
# 调试用：设为任意 6 位数字（如 "888888"）时，接口跳过真实发送与校验，前端可直接输入该值通过；生产环境保持为空
VERIFY_CODE_DEBUG_BYPASS=

# ── 三方登录 / OAuth ──────────────────────────────────────────────────
# GitHub OAuth App 申请：https://github.com/settings/developers → New OAuth App
# 详细步骤见 docs-internal/oauth-setup.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 后端回调 URL，必须与 GitHub OAuth App 中「Authorization callback URL」完全一致
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# 前端地址；后端 exchange 完 code 后 302 跳到 <WEB_APP_URL>/oauth/callback
WEB_APP_URL=http://localhost:3000
