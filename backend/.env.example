# ── 数据库 ────────────────────────────────────────────────────────────
# Docker Compose 默认配置（宿主机端口 5433 避免与本机 PostgreSQL 冲突）
DATABASE_URL=postgresql+asyncpg://yuanai:password@localhost:5433/yuanai

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────
# 生产环境务必替换为随机字符串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI 大模型（至少配置一个，未配置的模型不会出现在模型列表中）────────
# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Agnes：聊天、图片与视频生成 https://www.agnes-ai.com/en/docs
# 图片/视频任务由后端 worker 通过 AGNES_API_KEY 调用，切勿写入前端环境变量。
AGNES_API_KEY=

# ElevenLabs Music：https://elevenlabs.io/docs/api-reference/music/compose
# 可选远程 provider；仅由后端 worker 调用，不能替代本机歌词 provider。
ELEVENLABS_API_KEY=
# Hugging Face token: 创建 Fine-grained token，Presets 选择 Inference
# https://huggingface.co/settings/tokens
HF_TOKEN=
# 默认使用本机 MusicGen；远程 Hugging Face 仅作为显式实验 provider
MEDIA_MUSIC_PROVIDER=local
HUGGINGFACE_MUSIC_MODEL=facebook/musicgen-small
HUGGINGFACE_MUSIC_BASE_URL=https://router.huggingface.co/hf-inference
MEDIA_MUSIC_LOCAL_MODEL=facebook/musicgen-small
MEDIA_MUSIC_LOCAL_DEVICE=auto
# 默认只读取本机已缓存模型；首次下载时临时设为 false 并通过 shell 注入 HTTP(S)_PROXY
MEDIA_MUSIC_LOCAL_FILES_ONLY=true
MEDIA_MUSIC_LOCAL_MAX_NEW_TOKENS=1500
# 远程 provider 限流、排队超时或不可用时自动退回本机 MusicGen
MEDIA_MUSIC_FALLBACK_TO_LOCAL=true
MEDIA_MUSIC_MAX_ATTEMPTS=4
MEDIA_MUSIC_RETRY_DELAY_SECONDS=2
MEDIA_MUSIC_TIMEOUT_SECONDS=120
MEDIA_MUSIC_LYRICS_MAX_CHARS=4000
# 歌词歌曲使用独立的本机 ACE-Step REST 服务，不加载进 FastAPI。
ACE_STEP_BASE_URL=http://127.0.0.1:8001
ACE_STEP_API_KEY=
ACE_STEP_MODEL=acestep-v15-turbo
ACE_STEP_TIMEOUT_SECONDS=900
ACE_STEP_POLL_INTERVAL_SECONDS=2
ACE_STEP_MAX_ATTEMPTS=3
ACE_STEP_MAX_POLL_FAILURES=5
MEDIA_VIDEO_POLL_INTERVAL_SECONDS=5
MEDIA_VIDEO_MAX_POLL_FAILURES=5
# 视频任务完成后用 ffmpeg 提取首帧封面；失败只降级为无封面，不影响视频结果。
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_VIDEO_POSTER_TIMEOUT_SECONDS=12
MEDIA_VIDEO_POSTER_MAX_BYTES=2097152

# AssemblyAI 语音转写：https://www.assemblyai.com/dashboard/signup
# 用于浏览器/端侧识别不可用时的录音转写，不使用 OpenAI 的 whisper-1。
ASSEMBLYAI_API_KEY=

# ── 联网搜索 ────────────────────────────────────────────────────────────
# auto: 优先本机 SearXNG，无服务时按顺序选择已配置的 Brave / Tavily。
# 可选值：auto | searxng | brave | tavily | disabled
SEARCH_PROVIDER=auto
SEARXNG_BASE_URL=http://127.0.0.1:8082
# 可选：仅当 Docker 中的 SearXNG 需要经由开发机代理出网时，在仓库根目录的 .env
# 设置 SEARXNG_PROXY_URL；默认留空并直接联网，绝不假设代理端口。
# Brave：https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=
# Tavily：https://app.tavily.com/home
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_PER_USER_LIMIT_PER_MINUTE=10

# Anthropic (Claude)：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── 文件存储（S3 兼容，默认使用 Docker Compose 内的 MinIO）────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=yuanai-files
S3_PUBLIC_URL=http://localhost:9000/yuanai-files

# ── 邮箱验证码（QQ 邮箱示例）───────────────────────────────────────────
# 用于注册时向填写的邮箱发送 6 位验证码；未配置 SMTP_USER 则验证码接口会返回 500
# 授权码获取：QQ 邮箱 → 设置 → 账户 → 开启"POP3/SMTP 服务" → 生成授权码（16 位字符串）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-account@qq.com
SMTP_PASSWORD=your-16-char-authorization-code
SMTP_FROM_NAME=元AI
VERIFY_CODE_TTL_SECONDS=600
VERIFY_CODE_SEND_INTERVAL_SECONDS=60
# 调试用：设为任意 6 位数字（如 "888888"）时，接口跳过真实发送与校验，前端可直接输入该值通过；生产环境保持为空
VERIFY_CODE_DEBUG_BYPASS=

# ── 扫码登录 ───────────────────────────────────────────────────────────
# 二维码有效期（秒）和单 IP 限流窗口；API 地址会写入二维码，生产环境应为 HTTPS。
QR_LOGIN_TTL_SECONDS=90
QR_LOGIN_POLL_AFTER_MS=1000
QR_LOGIN_API_BASE_URL=http://localhost:8000/api/v1
QR_LOGIN_CREATE_LIMIT=15
QR_LOGIN_ATTEMPT_LIMIT=12
QR_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ── 三方登录 / OAuth ──────────────────────────────────────────────────
# GitHub OAuth App 申请：https://github.com/settings/developers → New OAuth App
# 详细步骤见 docs-internal/oauth-setup.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 后端回调 URL，必须与 GitHub OAuth App 中「Authorization callback URL」完全一致
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# Google OAuth Client 申请：https://console.cloud.google.com → API 和服务 → 凭据
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 后端回调 URL，必须与 Google Cloud「已获授权的重定向 URI」完全一致
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# 前端地址；后端 exchange 完 code 后 302 跳到 <WEB_APP_URL>/oauth/callback
WEB_APP_URL=http://localhost:3000

# ── Web Push 推送（VAPID）──────────────────────────────────────────────
# 生成方式见 docs-internal/notifications-testing.md 第 7 节；私钥切勿提交
# 未配置时后端推送降级为 no-op，前端不发起订阅
# 前端无需配置：公钥由前端运行时经 GET /notifications/vapid-public-key 拉取
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT 标识「本应用服务器」的联系方式（mailto: 或 https:// URL），
# 整个部署共用一个、由运维方填写；推送服务异常时联系服务器运营方，而非终端用户。
# 与用户无关（用户侧只有浏览器自动生成的订阅）。生产环境建议填真实可达邮箱。
VAPID_SUBJECT=mailto:admin@yuanai.example

# ── 桌面执行节点参数加密密钥 ────────────────────────────────────────────
# 非调试部署必须显式配置（缺省时后端拒绝启动），且不得与 JWT_SECRET_KEY 相同。
# 生成方式示例：python -c "import secrets; print(secrets.token_hex(32))"
EXECUTION_NODE_ENCRYPTION_KEY=

# ── MCP 外部凭证（SecretStore）───────────────────────────────────────
# 数据库 SecretStore 主密钥：生产环境务必替换为随机值，不得与 JWT_SECRET_KEY 或
# EXECUTION_NODE_ENCRYPTION_KEY 共用；缺少该值时 db:// Secret 操作会 fail closed。
SECRET_STORE_ENCRYPTION_KEY=

# stdio MCP：仅允许部署显式列出的完整命令行，多条配置用分号分隔；留空关闭。
# 例如：/usr/local/bin/mcp-server --config /etc/yuanai/mcp.json
# 该 transport 运行在 bubblewrap 隔离子进程中，禁止 shell 命令和动态执行参数。
MCP_STDIO_COMMAND_ALLOWLIST=
MCP_STDIO_MAX_ARGUMENTS=16
MCP_STDIO_TIMEOUT_SECONDS=30
MCP_STDIO_MAX_OUTPUT_BYTES=65536
# 每个租户的密钥用独立环境变量，命名必须内嵌租户身份：
#   YUANAI_MCP_SECRET_<去掉连字符的大写用户UUID>_<用途名>
# 连接中引用格式：env://YUANAI_MCP_SECRET_<USER_ID>_<NAME>；
# 租户只能解析内嵌自己 UUID 的引用，跨租户引用会被拒绝。
# 示例：YUANAI_MCP_SECRET_3F2A1B9C4D5E6F708192A3B4C5D6E7F2_GITHUB_TOKEN=ghp_xxx
