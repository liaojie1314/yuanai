{
  "name": "yuanai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "22.21.1",
    "pnpm": "10.22.0"
  },
  "volta": {
    "node": "22.21.1",
    "pnpm": "10.22.0"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "predev:mock": "pnpm check:runtime",
    "predev:real": "pnpm check:runtime",
    "predev:desktop": "pnpm check:runtime",
    "predev:mobile": "pnpm check:runtime",
    "predev:mobile:mock": "pnpm check:runtime",
    "presetup": "pnpm check:runtime",
    "dev": "turbo run dev",
    "dev:mock": "pnpm --filter @yuanai/web dev:mock",
    "dev:real": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "dev:mobile:mock": "node scripts/dev-mobile-mock.mjs",
    "setup:search": "node scripts/ensure-searxng-secret.mjs",
    "preview:desktop": "pnpm --filter @yuanai/desktop preview",
    "setup": "node scripts/setup.mjs",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @yuanai/desktop build",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:desktop:linux": "pnpm --filter @yuanai/desktop package:linux",
    "package:desktop:mac": "pnpm --filter @yuanai/desktop package:mac",
    "package:desktop:win": "pnpm --filter @yuanai/desktop package:win",
    "package:desktop:all": "pnpm --filter @yuanai/desktop package:all",
    "package:mobile:android": "pnpm --filter @yuanai/mobile package:android:local",
    "release:upload:android": "node scripts/upload-android-release.mjs",
    "signing:android": "node scripts/generate-android-keystore.mjs",
    "signing:desktop:windows:test": "node scripts/generate-desktop-test-certificate.mjs",
    "release": "release-it",
    "release:patch": "release-it --patch",
    "release:minor": "release-it --minor",
    "release:major": "release-it --major",
    "release:dry": "release-it --dry-run --no-git.requireBranch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yaml,css}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yaml,css}\"",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "@release-it/conventional-changelog": "12.0.0",
    "release-it": "21.0.2",
    "turbo": "2.10.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "apps/**/*.{json,css}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
